generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id            String   @id @default(cuid())
  externalId    String   @unique
  sport         String
  league        String
  homeTeam      String
  awayTeam      String
  commenceTime  DateTime
  status        String   @default("upcoming")
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  odds          GameOdds[]
  edgeScores    EdgeScore[]
  bets          Bet[]
}

model GameOdds {
  id          String   @id @default(cuid())
  gameId      String
  bookmaker   String
  market      String
  team        String
  price       Float
  point       Float?
  fetchedAt   DateTime @default(now())

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model EdgeScore {
  id                    String   @id @default(cuid())
  gameId                String
  team                  String
  market                String

  historicalScore       Float    @default(0)
  injuryScore           Float    @default(0)
  analystScore          Float    @default(0)
  homeAwayScore         Float    @default(0)
  lineMovementScore     Float    @default(0)
  expectedValue         Float    @default(0)

  overallEdge           Float    @default(0)
  confidence            String   @default("low")
  recommendation        String   @default("pass")

  calculatedAt          DateTime @default(now())
  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Bet {
  id          String   @id @default(cuid())
  gameId      String?
  sport       String
  league      String
  homeTeam    String
  awayTeam    String
  betType     String
  team        String
  odds        Float
  stake       Float
  potentialWin Float
  status      String   @default("pending")
  placedAt    DateTime @default(now())
  settledAt   DateTime?
  notes       String?

  game        Game?    @relation(fields: [gameId], references: [id])
}

model AnalystPick {
  id          String   @id @default(cuid())
  gameId      String
  source      String
  analyst     String
  pick        String
  confidence  String
  reasoning   String?
  createdAt   DateTime @default(now())
}
